{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/check.js", "--hook"],
            "timeout": 120,
            "statusMessage": "FTypechecks"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/check.js", "--stop"],
            "timeout": 300,
            "statusMessage": "FTypechecks: files edited this turn"
          }
        ]
      }
    ]
  }
}
